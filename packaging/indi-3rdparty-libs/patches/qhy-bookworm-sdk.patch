Description: Select the pinned QHY compatibility source component for Bookworm amd64
 QHY 26.7.21 x64 requires GLIBC_2.38 and GLIBCXX_3.4.32. The supplementary
 source component supplies 26.2.1 with matching headers, firmware and notices.
Author: RPi Astro maintainers <maintainers@darkdragonsastro.org>
Forwarded: not-needed
--- a/libqhy/CMakeLists.txt
+++ b/libqhy/CMakeLists.txt
@@ -1,6 +1,12 @@
 cmake_minimum_required(VERSION 3.16)
 project (libqhy)
 
+if(RPI_ASTRO_QHY_BOOKWORM)
+  add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/../qhybookworm/libqhy"
+                   "${CMAKE_CURRENT_BINARY_DIR}/qhybookworm")
+  return()
+endif()
+
 # QHY SDK 26.07.21
 set (LIBQHY_VERSION "26.7.21")
 set (LIBQHY_SOVERSION "20")

Section: libs
Architecture: any
Multi-Arch: same
Depends: ${shlibs:Depends}, ${misc:Depends}
Description: INDI driver library
 Shared driver support and LX200 protocol libraries.

Package: libindialignmentdriver2
Section: libs
Architecture: any
Multi-Arch: same
Depends: ${shlibs:Depends}, ${misc:Depends}
Description: INDI telescope alignment library
 Telescope alignment support library.

Package: libindi-plugins
Section: libs
Architecture: any
Multi-Arch: same
Depends: ${shlibs:Depends}, ${misc:Depends}
Description: mathematical plugins for INDI telescope alignment
 Dynamically loaded alignment models for INDI telescope drivers.

Package: libindi-dev
Section: libdevel
Architecture: any
Multi-Arch: same
Depends: ${misc:Depends}, libindiclient2 (= ${binary:Version}), libindidriver2 (= ${binary:Version}), libindialignmentdriver2 (= ${binary:Version}), libusb-1.0-0-dev

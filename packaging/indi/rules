#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
%:
	dh $@ --buildsystem=cmake
override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=RelWithDebInfo -DFIX_WARNINGS=OFF -DINDI_BUILD_EXAMPLES=OFF -DINDI_BUILD_STATIC=OFF -DUDEVRULES_INSTALL_DIR=/usr/lib/udev/rules.d
override_dh_strip:
	dh_strip --no-automatic-dbgsym
